# EduCenter Telegram CRM - environment configuration.
# Copy to `.env` and fill in real values. NEVER commit `.env` to git.

# --- General -------------------------------------------------------------------------------
# production | development
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_JSON=true

# --- PostgreSQL (used by docker compose) ------------------------------------------------------
POSTGRES_USER=educenter
POSTGRES_PASSWORD=change-me-to-a-long-random-password
POSTGRES_DB=educenter
# For running the backend outside Docker set DATABASE_URL directly instead:
# DATABASE_URL=postgresql+asyncpg://educenter:password@localhost:5432/educenter

# --- Web -------------------------------------------------------------------------------------
# Keep on localhost and put an HTTPS reverse proxy in front.
WEB_BIND=127.0.0.1
WEB_PORT=8080
SESSION_TTL_HOURS=12
# COOKIE_SECURE defaults to true when ENVIRONMENT=production (requires HTTPS).
# CORS is not needed when the dashboard and API share one origin (the default setup).
CORS_ORIGINS=
# Number of reverse proxies in front of the API (nginx `web` = 1; add 1 for each HTTPS proxy).
TRUSTED_PROXY_COUNT=1

# --- Telegram (https://my.telegram.org/apps) ---------------------------------------------------
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional: phone number used by the one-time login wizard (otherwise it asks).
TELEGRAM_PHONE=
TELEGRAM_SESSION_NAME=educenter
TELEGRAM_DEVICE_MODEL=EduCenter CRM

# --- Optional: separate bot for administrator alerts (alert channel "bot") ---------------------
# Create with @BotFather; each administrator must press /start in the bot once.
ALERT_BOT_TOKEN=

# --- Worker tuning (defaults are fine) --------------------------------------------------------
WORKER_TICK_SECONDS=5
WORKER_HEARTBEAT_SECONDS=15
WORKER_STALE_AFTER_SECONDS=60
